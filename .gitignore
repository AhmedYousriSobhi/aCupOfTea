# Ignore Sphinx build output
docs/build/

# Python bytecode caches
__pycache__/
*.pyc

# Weights & Biases local run logs
wandb/

# Local staging copy of the site (.docs/tools/stage_site.py)
_site/

.venv/

# Claude Code: the project skills (.claude/skills/<name>/) are committed; everything else
# under .claude/ is local (settings, agents, worktrees, launch config), and so is the
# symlinked ui-ux-pro-max skill
.claude/*
!.claude/skills/
.claude/skills/settings.json
.claude/skills/ui-ux-pro-max

# Local search index (python3 .docs/tools/build_search_index.py --local)
.docs/index-titles.json
.docs/index-body.json
